# Firebase Web App Configuration (Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic Cloud Fallback Model
VITE_FIREBASE_CLOUD_MODEL=gemini-3-flash-preview

# Firebase App Check Configuration
# Leave empty when using reCAPTCHA; set to "true" in local dev only if registering a debug token UUID.
VITE_APPCHECK_DEBUG_TOKEN=
# App Check provider: recaptcha-enterprise (recommended) or recaptcha-v3
VITE_APPCHECK_PROVIDER=recaptcha-enterprise
# Production reCAPTCHA site key
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Enable limited-use App Check tokens for Firebase AI Logic
VITE_APPCHECK_LIMITED_USE=false
