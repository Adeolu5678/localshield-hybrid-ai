# Firebase Web App Configuration (Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase AI Logic Cloud Fallback Model
VITE_FIREBASE_CLOUD_MODEL=gemini-2.5-flash

# Firebase App Check Configuration
# Set to "true" in local development to log a debug token in the browser console
# or paste a registered App Check debug token UUID from Firebase Console.
VITE_APPCHECK_DEBUG_TOKEN=true
# Production reCAPTCHA v3 site key (used when VITE_APPCHECK_DEBUG_TOKEN is empty)
VITE_APPCHECK_RECAPTCHA_SITE_KEY=
# Enable limited-use App Check tokens for Firebase AI Logic
VITE_APPCHECK_LIMITED_USE=false
